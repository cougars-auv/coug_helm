<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <TreeNodesModel>
    <Condition ID="IsOdomHealthy"/>
    <Condition ID="IsTagDetected">
      <input_port name="tag_id"/>
      <output_port name="approach_pose"/>
    </Condition>
    <Condition ID="IsWaypointsReceived"/>
    <Action ID="AdvanceWaypoint">
      <input_port name="active_waypoints"/>
      <inout_port name="waypoint_index"/>
    </Action>
    <Action ID="LoadGoalPose">
      <input_port name="active_waypoints"/>
      <input_port name="waypoint_index"/>
      <output_port name="goal_pose"/>
      <output_port name="goal_waypoint"/>
      <output_port name="goal_type"/>
    </Action>
    <Action ID="LoadSearchPoses">
      <input_port name="goal_waypoint"/>
      <output_port name="tag_id"/>
      <output_port name="search_poses"/>
    </Action>
    <Action ID="ComputeHomeWaypoint">
      <output_port name="home_waypoint"/>
    </Action>
    <Action ID="LoadBehavior">
      <output_port name="active_behavior"/>
    </Action>
    <Action ID="NavigateToPose">
      <input_port name="goal"/>
    </Action>
    <Decorator ID="LoopPose">
      <input_port name="queue"/>
      <output_port name="value"/>
    </Decorator>
    <Action ID="LoadWaypoints">
      <input_port name="pending_waypoints"/>
      <output_port name="active_waypoints"/>
      <output_port name="waypoint_index"/>
    </Action>
  </TreeNodesModel>

  <BehaviorTree ID="FollowWaypointsNav2WithAruco">
    <ReactiveSequence>
      <IsOdomHealthy/>
      <KeepRunningUntilFailure>
        <Sequence>
          <LoadGoalPose active_waypoints="{active_waypoints}" waypoint_index="{waypoint_index}"
              goal_pose="{goal_pose}" goal_waypoint="{goal_waypoint}" goal_type="{goal_type}"/>
          <Fallback>
            <Sequence>
              <ScriptCondition code="goal_type == kGps"/>
              <NavigateToPose goal="{goal_pose}"/>
            </Sequence>
            <Sequence>
              <ScriptCondition code="goal_type == kAruco"/>
              <LoadSearchPoses goal_waypoint="{goal_waypoint}" tag_id="{tag_id}"
                  search_poses="{search_poses}"/>
              <ReactiveFallback>
                <IsTagDetected tag_id="{tag_id}" approach_pose="{approach_pose}"/>
                <Sequence>
                  <ForceSuccess>
                    <NavigateToPose goal="{goal_pose}"/>
                  </ForceSuccess>
                  <LoopPose queue="{search_poses}" value="{search_pose}">
                    <ForceSuccess>
                      <NavigateToPose goal="{search_pose}"/>
                    </ForceSuccess>
                  </LoopPose>
                  <AlwaysFailure/>
                </Sequence>
              </ReactiveFallback>
              <NavigateToPose goal="{approach_pose}"/>
            </Sequence>
            <AlwaysFailure/>
          </Fallback>
          <AdvanceWaypoint active_waypoints="{active_waypoints}" waypoint_index="{waypoint_index}"/>
        </Sequence>
      </KeepRunningUntilFailure>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="MissionBehavior">
    <Sequence>
      <IsWaypointsReceived/>
      <LoadWaypoints pending_waypoints="{mission_waypoints}" active_waypoints="{active_waypoints}"
          waypoint_index="{waypoint_index}"/>
      <SubTree ID="FollowWaypointsNav2WithAruco" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="HomeBehavior">
    <Sequence>
      <IsWaypointsReceived/>
      <ComputeHomeWaypoint home_waypoint="{home_waypoint}"/>
      <LoadWaypoints pending_waypoints="{home_waypoint}" active_waypoints="{active_waypoints}"
          waypoint_index="{waypoint_index}"/>
      <SubTree ID="FollowWaypointsNav2WithAruco" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MainTree">
    <ReactiveSequence>
      <LoadBehavior active_behavior="{active_behavior}"/>
      <ReactiveFallback>
        <ReactiveSequence>
          <ScriptCondition code="active_behavior == kMission"/>
          <Sequence>
            <ForceSuccess>
              <SubTree ID="MissionBehavior" _autoremap="true"/>
            </ForceSuccess>
            <Script code="pending_behavior := kStop"/>
          </Sequence>
        </ReactiveSequence>
        <ReactiveSequence>
          <ScriptCondition code="active_behavior == kHome"/>
          <Sequence>
            <ForceSuccess>
              <SubTree ID="HomeBehavior" _autoremap="true"/>
            </ForceSuccess>
            <Script code="pending_behavior := kStop"/>
          </Sequence>
        </ReactiveSequence>
        <AlwaysSuccess/>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>

</root>
