<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <TreeNodesModel>
    <Condition ID="IsOdomHealthy"/>
    <Condition ID="IsWaypointsReceived"/>
    <Action ID="AdvanceWaypoint">
      <input_port name="active_waypoints"/>
      <inout_port name="waypoint_index"/>
    </Action>
    <Action ID="BackUp"/>
    <Action ID="ComputeHomeWaypoint">
      <output_port name="home_waypoint"/>
    </Action>
    <Action ID="ComputeSurfaceWaypoint">
      <output_port name="surface_waypoint"/>
    </Action>
    <Action ID="DisarmThruster"/>
    <Action ID="EmergencySurface"/>
    <Action ID="LoadBehavior">
      <output_port name="active_behavior"/>
    </Action>
    <Action ID="LoadGoal">
      <input_port name="active_waypoints"/>
      <input_port name="waypoint_index"/>
      <output_port name="goal_pose"/>
      <output_port name="goal_waypoint"/>
      <output_port name="goal_type"/>
    </Action>
    <Action ID="LoadWaypoints">
      <input_port name="pending_waypoints"/>
      <output_port name="active_waypoints"/>
      <output_port name="waypoint_index"/>
    </Action>
    <Action ID="NavigateToWaypoint">
      <input_port name="goal_waypoint"/>
    </Action>
    <Action ID="ResetLocalization"/>
    <Action ID="Stop"/>
    <Control ID="RecoveryNode">
      <input_port name="number_of_retries"/>
    </Control>
    <Control ID="RoundRobin"/>
    <Decorator ID="ProgressChecker"/>
  </TreeNodesModel>

  <BehaviorTree ID="FollowWaypoints">
    <ReactiveSequence>
      <Fallback>
        <IsOdomHealthy/>
        <Sequence>
          <EmergencySurface/>
          <ReactiveSequence>
            <Stop/>
            <ResetLocalization/>
          </ReactiveSequence>
          <ReactiveFallback>
            <IsOdomHealthy/>
            <ReactiveSequence>
              <Stop/>
              <Sequence>
                <Sleep msec="{odom_recovery_timeout_msec}"/>
                <AlwaysFailure/>
              </Sequence>
            </ReactiveSequence>
          </ReactiveFallback>
        </Sequence>
      </Fallback>
      <KeepRunningUntilFailure>
        <Sequence>
          <LoadGoal active_waypoints="{active_waypoints}" waypoint_index="{waypoint_index}"
              goal_pose="{goal_pose}" goal_waypoint="{goal_waypoint}" goal_type="{goal_type}"/>
          <RecoveryNode number_of_retries="{number_of_retries}">
            <ProgressChecker>
              <NavigateToWaypoint goal_waypoint="{goal_waypoint}"/>
            </ProgressChecker>
            <RoundRobin>
              <ReactiveSequence>
                <Stop/>
                <Sleep msec="{wait_duration_msec}"/>
              </ReactiveSequence>
              <BackUp/>
            </RoundRobin>
          </RecoveryNode>
          <AdvanceWaypoint active_waypoints="{active_waypoints}" waypoint_index="{waypoint_index}"/>
        </Sequence>
      </KeepRunningUntilFailure>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="MissionBehavior">
    <Sequence>
      <IsWaypointsReceived/>
      <LoadWaypoints pending_waypoints="{mission_waypoints}" active_waypoints="{active_waypoints}"
          waypoint_index="{waypoint_index}"/>
      <SubTree ID="FollowWaypoints" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="HomeBehavior">
    <Sequence>
      <IsWaypointsReceived/>
      <ComputeHomeWaypoint home_waypoint="{home_waypoint}"/>
      <LoadWaypoints pending_waypoints="{home_waypoint}" active_waypoints="{active_waypoints}"
          waypoint_index="{waypoint_index}"/>
      <SubTree ID="FollowWaypoints" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SurfaceBehavior">
    <Sequence>
      <ComputeSurfaceWaypoint surface_waypoint="{surface_waypoint}"/>
      <LoadWaypoints pending_waypoints="{surface_waypoint}" active_waypoints="{active_waypoints}"
          waypoint_index="{waypoint_index}"/>
      <SubTree ID="FollowWaypoints" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MainTree">
    <ReactiveSequence>
      <LoadBehavior active_behavior="{active_behavior}"/>
      <ReactiveFallback>
        <ReactiveSequence>
          <ScriptCondition code="active_behavior == kEmergencyStop"/>
          <Sequence>
            <Stop/>
            <ForceSuccess>
              <ReactiveSequence>
                <Stop/>
                <DisarmThruster/>
              </ReactiveSequence>
            </ForceSuccess>
            <Script code="pending_behavior := kStop"/>
          </Sequence>
        </ReactiveSequence>
        <ReactiveSequence>
          <ScriptCondition code="active_behavior == kEmergencySurface"/>
          <Sequence>
            <Stop/>
            <ForceSuccess>
              <EmergencySurface/>
            </ForceSuccess>
            <Script code="pending_behavior := kStop"/>
          </Sequence>
        </ReactiveSequence>
        <ReactiveSequence>
          <ScriptCondition code="active_behavior == kMission"/>
          <Sequence>
            <ForceSuccess>
              <SubTree ID="MissionBehavior" _autoremap="true"/>
            </ForceSuccess>
            <Script code="pending_behavior := kStop"/>
          </Sequence>
        </ReactiveSequence>
        <ReactiveSequence>
          <ScriptCondition code="active_behavior == kHome"/>
          <Sequence>
            <ForceSuccess>
              <SubTree ID="HomeBehavior" _autoremap="true"/>
            </ForceSuccess>
            <Script code="pending_behavior := kStop"/>
          </Sequence>
        </ReactiveSequence>
        <ReactiveSequence>
          <ScriptCondition code="active_behavior == kSurface"/>
          <Sequence>
            <ForceSuccess>
              <SubTree ID="SurfaceBehavior" _autoremap="true"/>
            </ForceSuccess>
            <Script code="pending_behavior := kStop"/>
          </Sequence>
        </ReactiveSequence>
        <Stop/>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>

</root>
