<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <TreeNodesModel>
    <Condition ID="IsOdomHealthy">
      <input_port name="last_odom_time"/>
      <input_port name="current_time"/>
      <input_port name="odom_timeout"/>
    </Condition>
    <Condition ID="IsWaypointsReceived">
      <input_port name="mission_waypoints"/>
    </Condition>
    <Action ID="BackUp"/>
    <Action ID="ComputeHomeWaypoint">
      <input_port name="mission_waypoints"/>
      <input_port name="default_speed"/>
      <input_port name="home_capture_radius"/>
      <input_port name="home_capture_radius_z"/>
      <input_port name="home_slip_radius"/>
      <input_port name="home_slip_radius_z"/>
      <output_port name="home_waypoint"/>
    </Action>
    <Action ID="ComputeSurfaceWaypoint">
      <input_port name="current_x"/>
      <input_port name="current_y"/>
      <input_port name="default_speed"/>
      <input_port name="surface_capture_radius"/>
      <input_port name="surface_capture_radius_z"/>
      <input_port name="surface_slip_radius"/>
      <input_port name="surface_slip_radius_z"/>
      <output_port name="surface_waypoint"/>
    </Action>
    <Action ID="DisarmThruster"/>
    <Action ID="EmergencySurface"/>
    <Action ID="FollowWaypoints">
      <input_port name="active_waypoints"/>
      <input_port name="current_x"/>
      <input_port name="current_y"/>
      <input_port name="current_z"/>
      <inout_port name="current_waypoint"/>
      <inout_port name="prev_norm_dist"/>
    </Action>
    <Action ID="LoadBehavior">
      <input_port name="pending_behavior"/>
      <output_port name="active_behavior"/>
    </Action>
    <Action ID="LoadWaypoints">
      <input_port name="pending_waypoints"/>
      <output_port name="active_waypoints"/>
      <output_port name="current_waypoint"/>
      <output_port name="prev_norm_dist"/>
    </Action>
    <Action ID="ResetLocalization"/>
    <Action ID="Stop"/>
    <Action ID="Wait">
      <input_port name="wait_duration"/>
    </Action>
    <Control ID="RecoveryNode">
      <input_port name="number_of_retries"/>
    </Control>
    <Control ID="RoundRobin"/>
    <Decorator ID="ProgressChecker">
      <input_port name="current_x"/>
      <input_port name="current_y"/>
      <input_port name="current_z"/>
      <input_port name="current_time"/>
      <input_port name="progress_threshold"/>
      <input_port name="progress_timeout"/>
    </Decorator>
  </TreeNodesModel>

  <BehaviorTree ID="FollowWaypointsWithRecovery">
    <ReactiveSequence>
      <Fallback>
        <IsOdomHealthy
            last_odom_time="{last_odom_time}"
            current_time="{current_time}"
            odom_timeout="{odom_timeout_sec}"/>
        <Sequence>
          <EmergencySurface/>
          <ResetLocalization/>
          <ReactiveFallback>
            <IsOdomHealthy
                last_odom_time="{last_odom_time}"
                current_time="{current_time}"
                odom_timeout="{odom_timeout_sec}"/>
            <Sequence>
              <Wait wait_duration="{odom_recovery_timeout_sec}"/>
              <AlwaysFailure/>
            </Sequence>
          </ReactiveFallback>
        </Sequence>
      </Fallback>
      <RecoveryNode number_of_retries="{number_of_retries}">
        <ProgressChecker
            current_x="{current_x}"
            current_y="{current_y}"
            current_z="{current_z}"
            current_time="{current_time}"
            progress_threshold="{progress_threshold}"
            progress_timeout="{progress_timeout_sec}">
          <FollowWaypoints
              active_waypoints="{active_waypoints}"
              current_x="{current_x}"
              current_y="{current_y}"
              current_z="{current_z}"
              current_waypoint="{current_waypoint}"
              prev_norm_dist="{prev_norm_dist}"/>
        </ProgressChecker>
        <RoundRobin>
          <Wait wait_duration="{wait_duration_sec}"/>
          <BackUp/>
        </RoundRobin>
      </RecoveryNode>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="MissionBehavior">
    <Sequence>
      <IsWaypointsReceived mission_waypoints="{mission_waypoints}"/>
      <LoadWaypoints pending_waypoints="{mission_waypoints}" active_waypoints="{active_waypoints}"
          current_waypoint="{current_waypoint}" prev_norm_dist="{prev_norm_dist}"/>
      <SubTree ID="FollowWaypointsWithRecovery" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="HomeBehavior">
    <Sequence>
      <IsWaypointsReceived mission_waypoints="{mission_waypoints}"/>
      <ComputeHomeWaypoint
          mission_waypoints="{mission_waypoints}"
          default_speed="{default_speed}"
          home_capture_radius="{home_capture_radius}"
          home_capture_radius_z="{home_capture_radius_z}"
          home_slip_radius="{home_slip_radius}"
          home_slip_radius_z="{home_slip_radius_z}"
          home_waypoint="{home_waypoint}"/>
      <LoadWaypoints pending_waypoints="{home_waypoint}" active_waypoints="{active_waypoints}"
          current_waypoint="{current_waypoint}" prev_norm_dist="{prev_norm_dist}"/>
      <SubTree ID="FollowWaypointsWithRecovery" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SurfaceBehavior">
    <Sequence>
      <ComputeSurfaceWaypoint
          current_x="{current_x}"
          current_y="{current_y}"
          default_speed="{default_speed}"
          surface_capture_radius="{surface_capture_radius}"
          surface_capture_radius_z="{surface_capture_radius_z}"
          surface_slip_radius="{surface_slip_radius}"
          surface_slip_radius_z="{surface_slip_radius_z}"
          surface_waypoint="{surface_waypoint}"/>
      <LoadWaypoints pending_waypoints="{surface_waypoint}" active_waypoints="{active_waypoints}"
          current_waypoint="{current_waypoint}" prev_norm_dist="{prev_norm_dist}"/>
      <SubTree ID="FollowWaypointsWithRecovery" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MainTree">
    <ReactiveSequence>
      <LoadBehavior pending_behavior="{pending_behavior}" active_behavior="{active_behavior}"/>
      <ReactiveFallback>
        <ReactiveSequence>
          <ScriptCondition code="active_behavior == kEmergencyStop"/>
          <Sequence>
            <Stop/>
            <ForceSuccess>
              <DisarmThruster/>
            </ForceSuccess>
            <Script code="pending_behavior := kStop"/>
          </Sequence>
        </ReactiveSequence>
        <ReactiveSequence>
          <ScriptCondition code="active_behavior == kEmergencySurface"/>
          <Sequence>
            <Stop/>
            <ForceSuccess>
              <EmergencySurface/>
            </ForceSuccess>
            <Script code="pending_behavior := kStop"/>
          </Sequence>
        </ReactiveSequence>
        <ReactiveSequence>
          <ScriptCondition code="active_behavior == kMission"/>
          <Sequence>
            <ForceSuccess>
              <SubTree ID="MissionBehavior" _autoremap="true"/>
            </ForceSuccess>
            <Script code="pending_behavior := kStop"/>
          </Sequence>
        </ReactiveSequence>
        <ReactiveSequence>
          <ScriptCondition code="active_behavior == kHome"/>
          <Sequence>
            <ForceSuccess>
              <SubTree ID="HomeBehavior" _autoremap="true"/>
            </ForceSuccess>
            <Script code="pending_behavior := kStop"/>
          </Sequence>
        </ReactiveSequence>
        <ReactiveSequence>
          <ScriptCondition code="active_behavior == kSurface"/>
          <Sequence>
            <ForceSuccess>
              <SubTree ID="SurfaceBehavior" _autoremap="true"/>
            </ForceSuccess>
            <Script code="pending_behavior := kStop"/>
          </Sequence>
        </ReactiveSequence>
        <Stop/>
      </ReactiveFallback>
    </ReactiveSequence>
  </BehaviorTree>

</root>
