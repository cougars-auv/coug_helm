<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <!--
  @file bt_helm_tree.xml
  @brief Behavior tree for waypoint mission execution.
  @author Nelson Durrant
  @date May 2026
  -->

  <TreeNodesModel>
    <Condition ID="CheckOdomHealthy">
      <input_port name="last_odom_time"/>
      <input_port name="current_time"/>
      <input_port name="odom_timeout_sec"/>
    </Condition>
    <Condition ID="CheckMissionActive">
      <input_port name="active_waypoints"/>
      <input_port name="mission_active"/>
    </Condition>
    <Condition ID="CheckMissionComplete">
      <input_port name="active_waypoints"/>
      <input_port name="waypoint_index"/>
    </Condition>
    <Condition ID="CheckCommand">
      <input_port name="command"/>
      <input_port name="pending_command"/>
    </Condition>
    <Action ID="ClearCommand">
      <output_port name="pending_command"/>
    </Action>
    <Action ID="SetMissionActive">
      <input_port name="value"/>
      <output_port name="mission_active"/>
    </Action>
    <Action ID="ResetWaypointIndex">
      <output_port name="waypoint_index"/>
      <output_port name="prev_norm_dist"/>
    </Action>
    <Action ID="SetMissionWaypoints">
      <input_port name="mission_waypoints"/>
      <input_port name="mission_waypoint_speeds"/>
      <input_port name="default_capture_radius"/>
      <input_port name="mission_waypoint_capture_radii"/>
      <input_port name="default_slip_radius"/>
      <input_port name="mission_waypoint_slip_radii"/>
      <output_port name="active_waypoints"/>
      <output_port name="active_waypoint_speeds"/>
      <output_port name="active_capture_radius"/>
      <output_port name="active_waypoint_capture_radii"/>
      <output_port name="active_slip_radius"/>
      <output_port name="active_waypoint_slip_radii"/>
    </Action>
    <Action ID="SetSurfaceWaypoint">
      <input_port name="current_x"/>
      <input_port name="current_y"/>
      <input_port name="default_speed"/>
      <input_port name="surface_capture_radius"/>
      <input_port name="surface_slip_radius"/>
      <output_port name="active_waypoints"/>
      <output_port name="active_waypoint_speeds"/>
      <output_port name="active_capture_radius"/>
      <output_port name="active_waypoint_capture_radii"/>
      <output_port name="active_slip_radius"/>
      <output_port name="active_waypoint_slip_radii"/>
    </Action>
    <Action ID="SetHomeWaypoint">
      <input_port name="mission_waypoints"/>
      <input_port name="default_speed"/>
      <input_port name="home_capture_radius"/>
      <input_port name="home_slip_radius"/>
      <output_port name="active_waypoints"/>
      <output_port name="active_waypoint_speeds"/>
      <output_port name="active_capture_radius"/>
      <output_port name="active_waypoint_capture_radii"/>
      <output_port name="active_slip_radius"/>
      <output_port name="active_waypoint_slip_radii"/>
    </Action>
    <Action ID="ComputeHSD">
      <input_port name="active_waypoints"/>
      <input_port name="active_waypoint_speeds"/>
      <input_port name="waypoint_index"/>
      <input_port name="current_x"/>
      <input_port name="current_y"/>
      <input_port name="default_speed"/>
      <output_port name="heading"/>
      <output_port name="speed"/>
      <output_port name="depth"/>
      <output_port name="mode"/>
    </Action>
    <Action ID="PublishHSD">
      <input_port name="heading"/>
      <input_port name="speed"/>
      <input_port name="depth"/>
      <input_port name="mode"/>
    </Action>
    <Action ID="AdvanceIfReached">
      <input_port name="active_waypoints"/>
      <input_port name="current_x"/>
      <input_port name="current_y"/>
      <input_port name="current_z"/>
      <input_port name="active_capture_radius"/>
      <input_port name="active_waypoint_capture_radii"/>
      <input_port name="active_slip_radius"/>
      <input_port name="active_waypoint_slip_radii"/>
      <inout_port name="waypoint_index"/>
      <inout_port name="prev_norm_dist"/>
    </Action>
    <Action ID="StopVehicle"/>
  </TreeNodesModel>

  <BehaviorTree ID="CommandDispatch">
    <Fallback>
      <Sequence>
        <CheckCommand command="start" pending_command="{pending_command}"/>
        <SetMissionWaypoints
            mission_waypoints="{mission_waypoints}"
            mission_waypoint_speeds="{mission_waypoint_speeds}"
            default_capture_radius="{default_capture_radius}"
            mission_waypoint_capture_radii="{mission_waypoint_capture_radii}"
            default_slip_radius="{default_slip_radius}"
            mission_waypoint_slip_radii="{mission_waypoint_slip_radii}"
            active_waypoints="{active_waypoints}"
            active_waypoint_speeds="{active_waypoint_speeds}"
            active_capture_radius="{active_capture_radius}"
            active_waypoint_capture_radii="{active_waypoint_capture_radii}"
            active_slip_radius="{active_slip_radius}"
            active_waypoint_slip_radii="{active_waypoint_slip_radii}"/>
        <ResetWaypointIndex waypoint_index="{waypoint_index}" prev_norm_dist="{prev_norm_dist}"/>
        <ClearCommand pending_command="{pending_command}"/>
        <SetMissionActive value="true" mission_active="{mission_active}"/>
      </Sequence>
      <Sequence>
        <CheckCommand command="stop" pending_command="{pending_command}"/>
        <ClearCommand pending_command="{pending_command}"/>
        <SetMissionActive value="false" mission_active="{mission_active}"/>
      </Sequence>
      <Sequence>
        <CheckCommand command="surface" pending_command="{pending_command}"/>
        <SetSurfaceWaypoint
            current_x="{current_x}"
            current_y="{current_y}"
            default_speed="{default_speed}"
            surface_capture_radius="{surface_capture_radius}"
            surface_slip_radius="{surface_slip_radius}"
            active_waypoints="{active_waypoints}"
            active_waypoint_speeds="{active_waypoint_speeds}"
            active_capture_radius="{active_capture_radius}"
            active_waypoint_capture_radii="{active_waypoint_capture_radii}"
            active_slip_radius="{active_slip_radius}"
            active_waypoint_slip_radii="{active_waypoint_slip_radii}"/>
        <ResetWaypointIndex waypoint_index="{waypoint_index}" prev_norm_dist="{prev_norm_dist}"/>
        <ClearCommand pending_command="{pending_command}"/>
        <SetMissionActive value="true" mission_active="{mission_active}"/>
      </Sequence>
      <Sequence>
        <CheckCommand command="home" pending_command="{pending_command}"/>
        <SetHomeWaypoint
            mission_waypoints="{mission_waypoints}"
            default_speed="{default_speed}"
            home_capture_radius="{home_capture_radius}"
            home_slip_radius="{home_slip_radius}"
            active_waypoints="{active_waypoints}"
            active_waypoint_speeds="{active_waypoint_speeds}"
            active_capture_radius="{active_capture_radius}"
            active_waypoint_capture_radii="{active_waypoint_capture_radii}"
            active_slip_radius="{active_slip_radius}"
            active_waypoint_slip_radii="{active_waypoint_slip_radii}"/>
        <ResetWaypointIndex waypoint_index="{waypoint_index}" prev_norm_dist="{prev_norm_dist}"/>
        <ClearCommand pending_command="{pending_command}"/>
        <SetMissionActive value="true" mission_active="{mission_active}"/>
      </Sequence>
      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="MainTree">
    <Fallback>
      <Sequence>
        <SubTree ID="CommandDispatch" _autoremap="true"/>
        <CheckOdomHealthy
            last_odom_time="{last_odom_time}"
            current_time="{current_time}"
            odom_timeout_sec="{odom_timeout_sec}"/>
        <CheckMissionActive active_waypoints="{active_waypoints}" mission_active="{mission_active}"/>
        <Inverter>
          <Sequence>
            <CheckMissionComplete active_waypoints="{active_waypoints}" waypoint_index="{waypoint_index}"/>
            <SetMissionActive value="false" mission_active="{mission_active}"/>
          </Sequence>
        </Inverter>
        <ComputeHSD
            active_waypoints="{active_waypoints}"
            active_waypoint_speeds="{active_waypoint_speeds}"
            waypoint_index="{waypoint_index}"
            current_x="{current_x}"
            current_y="{current_y}"
            default_speed="{default_speed}"
            heading="{heading}"
            speed="{speed}"
            depth="{depth}"
            mode="{mode}"/>
        <PublishHSD
            heading="{heading}"
            speed="{speed}"
            depth="{depth}"
            mode="{mode}"/>
        <AdvanceIfReached
            active_waypoints="{active_waypoints}"
            current_x="{current_x}"
            current_y="{current_y}"
            current_z="{current_z}"
            active_capture_radius="{active_capture_radius}"
            active_waypoint_capture_radii="{active_waypoint_capture_radii}"
            active_slip_radius="{active_slip_radius}"
            active_waypoint_slip_radii="{active_waypoint_slip_radii}"
            waypoint_index="{waypoint_index}"
            prev_norm_dist="{prev_norm_dist}"/>
      </Sequence>
      <StopVehicle/>
    </Fallback>
  </BehaviorTree>

</root>
